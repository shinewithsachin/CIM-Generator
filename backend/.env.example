# Copy this file to .env and fill in your values
# OR just configure via the UI (Settings tab)

# LLM Provider: auto | openai | anthropic | groq
LLM_PROVIDER=auto

# Your API key (can also be set via the UI)
LLM_API_KEY=your_api_key_here

# Optional provider-specific keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Model name
LLM_MODEL=gpt-4o

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=BAAI/bge-m3

# Vector backend: chroma | pgvector
VECTOR_BACKEND=chroma
POSTGRES_DSN=

# Storage paths
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
