# Copy this file to .env and fill in your values.
# Every value below has a working default — none are required to get the
# app running in Demo Mode. Fill in the ones relevant to your setup.

# ── LLM (system-wide fallback; each user can override their own via the UI) ──
LLM_PROVIDER=auto
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gpt-4o

# ── Embeddings (run locally, no API key needed) ──
EMBEDDING_MODEL=BAAI/bge-m3

# ── Vector backend ──
VECTOR_BACKEND=chroma
POSTGRES_DSN=

# ── Storage paths ──
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# ── Security ──
# JWT_SECRET_KEY and APP_ENCRYPTION_KEY: if left blank, a random value is
# generated on first run and persisted to backend/.secret_key and
# backend/.encryption_key (both gitignored). Set these explicitly for any
# real deployment so tokens/encrypted data survive redeploys deliberately,
# not just because a local file happened to stick around.
JWT_SECRET_KEY=
APP_ENCRYPTION_KEY=

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reject uploads larger than this (MB) at the API boundary.
MAX_UPLOAD_MB=50

# Sessions (+ their uploads/PDFs/vector rows) older than this are eligible
# for scripts/purge_expired_sessions.py.
RETENTION_DAYS=30
